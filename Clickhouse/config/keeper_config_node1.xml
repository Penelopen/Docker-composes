<clickhouse>
    <!-- Идентификация ноды для репликации по IP шлюза Docker (убирает DNS_ERROR) -->
    <interserver_http_host>clickhouse-node1</interserver_http_host>
    <listen_host>0.0.0.0</listen_host>

    <!-- ПАРАМЕТРЫ KEEPER -->    
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <!-- Листен здесь тоже не помешает для самого процесса кипера -->
        <listen_host>0.0.0.0</listen_host>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/keeper/logs</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/keeper/snapshots</snapshot_storage_path>
        
        <coordination_settings>
            <operation_timeout_ms>30000</operation_timeout_ms>
            <min_session_timeout_ms>10000</min_session_timeout_ms>
            <session_timeout_ms>100000</session_timeout_ms>
        </coordination_settings>

        <raft_configuration>
            <!-- Узел 1 (Docker Node 1) -->
            <server><id>1</id><hostname>clickhouse-node1</hostname><port>9444</port></server>
            <!-- Узел 2 (Docker Node 2) -->
            <server><id>2</id><hostname>clickhouse-node2</hostname><port>9444</port></server>
            <!-- Узел 3 (Docker Node 3) -->
            <server><id>3</id><hostname>clickhouse-node3</hostname><port>9444</port></server>
        </raft_configuration>
    </keeper_server>
</clickhouse>
